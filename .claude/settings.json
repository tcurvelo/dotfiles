{
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    }
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(git status:*)",
      "Bash(git tag)",
      "Bash(git tag --list:*)",
      "Bash(git worktree list)",
      "Bash(go test *)",
      "Bash(make lint)",
      "Bash(obsidian files *)",
      "Bash(obsidian folders*)",
      "Bash(obsidian search *)",
      "Bash(obsidian vault *)",
      "Bash(jq *)",
      "Bash(yq *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)"
    ]
  },
  "theme": "dark-daltonized",
  "tui": "fullscreen"
}
